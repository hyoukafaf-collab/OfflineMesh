<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 trở xuống (android:fullBackupContent). Ứng dụng này KHÔNG cho hệ thống sao lưu tự động dữ liệu của nó lên
  Google/Samsung: tin nhắn, danh bạ và tệp danh tính (khóa riêng bọc bằng Keystore) chỉ nằm trên máy này.
  Muốn sao lưu thì phải do người dùng chủ động (Cài đặt › Sao lưu và tài khoản, tệp .omb mã hóa bằng mật khẩu).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
