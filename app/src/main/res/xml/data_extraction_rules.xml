<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 trở lên (android:dataExtractionRules): loại trừ mọi dữ liệu khỏi sao lưu đám mây VÀ chuyển máy-sang-máy.
  Cần cả hai vì trên một số máy, android:allowBackup="false" chỉ tắt sao lưu đám mây mà vẫn cho chuyển máy-sang-máy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
